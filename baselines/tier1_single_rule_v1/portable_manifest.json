  "contract": {
    "function_signature": "priority(processing_time: float, remaining_work: float, remaining_operations: int, job_ready_time: float, machine_ready_time: float, earliest_start: float, earliest_finish: float) -> float",
    "features": {
      "processing_time": "positive duration of the operation on this candidate machine",
      "remaining_work": "sum of shortest eligible durations for current and later operations; positive",
      "remaining_operations": "count including current operation; positive integer",
      "job_ready_time": "completion time of the previously scheduled operation of this job; nonnegative",
      "machine_ready_time": "completion time of the last scheduled operation on this machine; nonnegative",
      "earliest_start": "max(job_ready_time, machine_ready_time); nonnegative",
      "earliest_finish": "earliest_start + processing_time; positive"
    },
    "return_constraint": "one finite real scalar; bool, strings, vectors, NaN and infinity are invalid",
    "score_direction": "higher priority wins; higher normalized score is better",
    "tie_break": "stable enumeration: lower job index, then lower machine index",
    "scheduler": "append-only constructor chooses the highest priority currently eligible operation-machine pair",
    "feasibility": "all operations once, eligible machine and exact duration, job precedence, no machine overlap, exact makespan",
    "lower_bound": "max(maximum per-job sum of minimum operation durations, ceil(total minimum operation workload / machine_count))",
    "instance_score": "-makespan/lower_bound",
    "training_fitness": "arithmetic mean of all 21 train instance scores"
  },
