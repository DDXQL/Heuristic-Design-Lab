  },
  "execution": {
    "mode": "mock",
    "slurm": {
      "partition": "128C_02", "account": "wz", "qos": "normal", "cpus": 2,
      "memory_mib": 2048, "wall_seconds": 1800, "evaluation_concurrency": 1
    },
    "api": {
      "global_concurrency": 8, "min_interval_seconds": 10, "queue_wait_seconds": 60,
      "timeout_seconds": 45, "evolution_reservation_cap": 20, "retry_delays_seconds": [],
      "consecutive_failed_slots": 0, "cooldown_429_seconds": 30,
      "model": "gpt-6.1-sol", "requests_per_minute": null
    },
    "window_hours": 4,
    "max_segments": 12
  }
}
