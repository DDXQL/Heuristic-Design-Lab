{
  "version": 1,
  "name": "r15p4-site-no-api",
  "research": {
    "problem": "tsp",
    "runs": [
      {"method": "u", "seed": 901, "initialization_attempts": 20},
      {"method": "u", "seed": 902, "initialization_attempts": 20},
      {"method": "u", "seed": 903, "initialization_attempts": 20}
    ],
    "training_manifest": "preparations/triad/tsp/train20.manifest.json",
    "frozen_h": "preparations/triad/tsp/H_frozen.json",
    "reference": "preparations/operations/tsp-reference-r15.json",
    "state": "common-state-a-v3",
    "evaluation": "train_J_min_T30",
    "champion": "best_valid_training_J_then_id",
    "holdout": "not_run",
    "budget": {"count": "successful_responses", "target": 20, "empty": "exclude", "truncated": "exclude"},
